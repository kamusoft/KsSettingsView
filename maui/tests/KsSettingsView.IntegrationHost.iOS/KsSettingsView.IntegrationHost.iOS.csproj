<Project Sdk="Microsoft.NET.Sdk">

  <!--
    iOS の Bridge binding を実機／シミュレータで縦に疎通させる検証ホスト。
    C# から Builder で設定ツリーを組み立て、Bridge が生成した Native Host を画面へ取り付けて
    表示できることを確認する。後続フェーズや SDK 更新時の回帰検証にそのまま使う。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <RootNamespace>KsSettingsView.IntegrationHost</RootNamespace>
    <AssemblyName>KsSettingsView.IntegrationHost.iOS</AssemblyName>
    <ApplicationId>jp.kamusoft.kssettingsview.integrationhost.ios</ApplicationId>
    <ApplicationTitle>KsBridge Host</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../macios/KsSettingsView.Binding.iOS/KsSettingsView.Binding.iOS.csproj" />
  </ItemGroup>

  <!-- 操作シナリオは Android ホストと共有する -->
  <ItemGroup>
    <Compile Include="../shared/KsBridgeScenario.cs" Link="KsBridgeScenario.cs" />
    <Compile Include="../shared/KsBridgeScenarioHandles.cs" Link="KsBridgeScenarioHandles.cs" />
  </ItemGroup>

</Project>
