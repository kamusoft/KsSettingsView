<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KsSettingsView.Maui のユニットテスト。Binding assembly を参照しない素の net10.0 で動かし、
    Bridge 呼び出しは fake gateway、flush の予約は fake dispatcher に差し替えて検証する。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KsSettingsView.Tests</RootNamespace>
    <AssemblyName>KsSettingsView.Maui.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KsSettingsView.Maui/KsSettingsView.Maui.csproj" />
  </ItemGroup>

</Project>
