<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI アプリ利用者向けの公開層。XAML / C# から使う SettingsView と、その内容を
    Native Bridge へ運ぶ変換経路を持つ。

    素の net10.0 を TargetFrameworks に含めるのは、Binding assembly (platform TFM でしか
    参照できない) から切り離した純ロジックをユニットテストで検証するため。
    Bridge 呼び出しは internal な gateway 抽象越しに行い、gateway の実体だけを platform TFM が持つ。
    (maui/ADR-0009)
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KsSettingsView</RootNamespace>
    <AssemblyName>KsSettingsView.Maui</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    NuGet パッケージとしての公開面。Package ID はアセンブリ名と同じ KsSettingsView.Maui で、
    名前空間 KsSettingsView とは非対称になる (maui/ADR-0025)。
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KsSettingsView.Maui</PackageId>
    <Description>A settings screen UI library for .NET MAUI, providing list-style settings screens with built-in cell types on iOS and Android. Successor to AiForms.Maui.SettingsView.</Description>
    <PackageTags>maui settings settingsview ios android</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- package README はこのパッケージ固有のため、共通の props ではなくここで同梱する -->
    <None Include="../../README.md" Pack="true" PackagePath="" Visible="false" />
    <!-- 最低 OS 版の検査を利用者のビルドへ届ける。定数の props と検査の targets を対で同梱する -->
    <None Include="buildTransitive/KsSettingsView.Maui.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/KsSettingsView.Maui.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <PropertyGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' ">
    <SupportedOSPlatformVersion>$(KsSettingsViewMinIOSVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' ">
    <SupportedOSPlatformVersion>$(KsSettingsViewMinAndroidApi)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <!--
    Platforms/ 配下は対象 platform の TFM でだけコンパイルする。
    既定の glob から一度外し、TFM ごとに明示して取り込む。
  -->
  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs" />
  </ItemGroup>

  <!-- Native Host を持たない TFM 用の Handler 実体は、platform TFM では使わない -->
  <ItemGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != '' ">
    <Compile Remove="Handlers/SettingsViewHandler.Standard.cs" />
  </ItemGroup>

  <ItemGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' ">
    <Compile Include="Platforms/iOS/**/*.cs" />
    <ProjectReference Include="../macios/KsSettingsView.Binding.iOS/KsSettingsView.Binding.iOS.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' ">
    <Compile Include="Platforms/Android/**/*.cs" />
    <ProjectReference Include="../android/KsSettingsView.Binding.Android/KsSettingsView.Binding.Android.csproj" />
  </ItemGroup>

  <!-- gateway 抽象と変換経路は internal のため、テストからの参照を許可する -->
  <ItemGroup>
    <InternalsVisibleTo Include="KsSettingsView.Maui.Tests" />
  </ItemGroup>

</Project>
