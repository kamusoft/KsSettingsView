<Project>

  <!--
    KsSettingsView が要求する最低 OS 版。この 2 つの定数がリポジトリと配布パッケージを通じた
    単一の宣言元であり、利用者ビルドの検査 (KsSettingsView.Maui.targets) と、リポジトリ内の
    facade / binding / 検証ホストの SupportedOSPlatformVersion がここから導かれる。

    Android 29: 本体の Android モジュールの minSdk。
    iOS 16.0: Bridge が依存する KsSettingsViewUI が UIHostingConfiguration を使うため。

    samples/maui の Sample アプリは別のビルドルートにあり、この props も配布パッケージも届かない
    (facade を ProjectReference で参照する) ため SupportedOSPlatformVersion を直書きしている。
    ここの値を変えるときは Sample の直書きも合わせる。
  -->
  <PropertyGroup>
    <KsSettingsViewMinAndroidApi>29</KsSettingsViewMinAndroidApi>
    <KsSettingsViewMinIOSVersion>16.0</KsSettingsViewMinIOSVersion>
  </PropertyGroup>

</Project>
