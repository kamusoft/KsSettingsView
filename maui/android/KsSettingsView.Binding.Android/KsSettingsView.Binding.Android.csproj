<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KsSettingsView の Android Bridge (`kssettingsview-bridge`) を .NET から呼び出すための binding。
    Bridge モジュールの aar を束縛し、Bridge が実行時に必要とする本体モジュール
    (`kssettingsview`) の aar を同梱する。

    この assembly は interop の輸送層であり、利用者向けの公開契約ではない (maui/ADR-0004)。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android モジュールの minSdk に合わせる (要件の数値は buildTransitive の props が宣言元) -->
    <SupportedOSPlatformVersion>$(KsSettingsViewMinAndroidApi)</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>KsSettingsView.Bridge</RootNamespace>
    <AssemblyName>KsSettingsView.Binding.Android</AssemblyName>
  </PropertyGroup>

  <!-- PackageId はアセンブリ名の既定に任せる -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Android native bridge binding for KsSettingsView.Maui. Referenced transitively by KsSettingsView.Maui; do not reference this package directly.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Android 本体の Gradle ビルドルート -->
    <KsAndroidRoot>$(MSBuildThisFileDirectory)../../../android/</KsAndroidRoot>
  </PropertyGroup>

  <!--
    束縛対象は Bridge モジュールだけにする。本体は Bridge の実行時依存であり、
    公開 API に型が現れないため同梱するだけで束縛しない。
  -->
  <ItemGroup>
    <AndroidLibrary Include="$(KsAndroidRoot)kssettingsview-bridge/build/outputs/aar/kssettingsview-bridge-release.aar" Bind="true" />
    <AndroidLibrary Include="$(KsAndroidRoot)kssettingsview/build/outputs/aar/kssettingsview-release.aar" Bind="false" />
  </ItemGroup>

  <!--
    本体 / Bridge が Gradle 側で implementation 依存として宣言しているライブラリと、
    LiveData family の版を揃えるための明示参照。版とその選定理由は Directory.Packages.props にある。
  -->
  <ItemGroup>
    <PackageReference Include="Xamarin.Kotlin.StdLib" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" />
    <PackageReference Include="Xamarin.AndroidX.Annotation" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" />
    <PackageReference Include="Xamarin.Google.Android.Material" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Foundation" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.ViewBinding" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
  </ItemGroup>

  <!-- Java パッケージ名から .NET namespace への変換など、生成コードの調整 -->
  <ItemGroup>
    <TransformFile Include="Transforms/Metadata.xml" />
  </ItemGroup>

  <!-- 束縛対象と同梱対象の aar を再生成するかの判定に使う入力 -->
  <ItemGroup>
    <KsAndroidModuleSource Include="$(KsAndroidRoot)kssettingsview/src/main/**/*" />
    <KsAndroidModuleSource Include="$(KsAndroidRoot)kssettingsview-bridge/src/main/**/*" />
    <KsAndroidModuleSource Include="$(KsAndroidRoot)*.kts" />
    <KsAndroidModuleSource Include="$(KsAndroidRoot)gradle.properties" />
    <!-- バージョンカタログと wrapper 設定はビルドスクリプト本体と同じく aar の内容を決める入力 -->
    <KsAndroidModuleSource Include="$(KsAndroidRoot)gradle/libs.versions.toml" />
    <KsAndroidModuleSource Include="$(KsAndroidRoot)gradle/wrapper/gradle-wrapper.properties" />
    <KsAndroidModuleSource Include="$(KsAndroidRoot)kssettingsview/build.gradle.kts" />
    <KsAndroidModuleSource Include="$(KsAndroidRoot)kssettingsview-bridge/build.gradle.kts" />
  </ItemGroup>

  <!--
    aar は本体の Gradle ビルドをそのまま呼んで生成する。
    SDK の AndroidGradleProject アイテムは単一モジュール構成を前提に全 project の
    出力ディレクトリを1か所へ束ねるため、複数モジュールを持つ本体ビルドには使えない。
    方式の採否と見直し条件は maui/ADR-0006 を参照。
  -->
  <Target Name="_BuildKsSettingsViewAars"
      DependsOnTargets="AndroidPrepareForBuild"
      BeforeTargets="_CategorizeAndroidLibraries;_ResolveLibraryProjectImports"
      Inputs="@(KsAndroidModuleSource)"
      Outputs="@(AndroidLibrary)">
    <Exec Command="./gradlew --console=plain :kssettingsview:assembleRelease :kssettingsview-bridge:assembleRelease"
        WorkingDirectory="$(KsAndroidRoot)"
        EnvironmentVariables="JAVA_HOME=$(JavaSdkDirectory);ANDROID_HOME=$(AndroidSdkDirectory)" />
  </Target>

</Project>
