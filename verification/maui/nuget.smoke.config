<?xml version="1.0" encoding="utf-8"?>
<!--
  smoke の参照先。KsSettingsView.* を含むすべての依存を nuget.org から取得する。
  ローカル参照先は列挙しない。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
