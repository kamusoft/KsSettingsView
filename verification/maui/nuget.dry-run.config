<?xml version="1.0" encoding="utf-8"?>
<!--
  dry-run の参照先。KsSettingsView.* はローカルフォルダフィードからだけ取得し、
  他の依存 (MAUI 本体・AndroidX 系) は nuget.org から取得する。

  packageSourceMapping により、フィードに無い version を要求した場合は nuget.org へ
  フォールバックせず解決失敗になる。フィードの場所は環境変数で受け取る。

  mapping は global packages folder に既に展開済みのパッケージには働かないため、
  消費者ビルドは実行ごとに空の RestorePackagesPath を与える。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="kssettingsview-local" value="%KSSV_LOCAL_FEED%" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="kssettingsview-local">
      <package pattern="KsSettingsView.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
