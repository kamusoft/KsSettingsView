<?xml version="1.0" encoding="utf-8" ?>
<!--
  Root / Section の Header・Footer へ任意の View を置くデモ画面。
  ① 〜 ⑦ の番号は画面上で確認する項目の並びに対応する。
  Header / Footer への View 配置は MAUI facade 固有の機能で、iOS / Android の Sample に対応画面はない。
  タイトルは SampleScreen の一元定義から与えられるため、ここでは設定しない。
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ks="clr-namespace:KsSettingsView;assembly=KsSettingsView.Maui"
             xmlns:vm="clr-namespace:KsSettingsView.Sample.Maui.ViewModels"
             x:Class="KsSettingsView.Sample.Maui.Pages.AccessoryViewsDemoPage"
             x:DataType="vm:AccessoryViewsDemoViewModel">
  <ks:SettingsView x:Name="Settings">

    <!-- ① list 全体の先頭と末尾に置く View。 -->
    <ks:SettingsView.RootHeaderView>
      <Border BackgroundColor="#DDEBFF" StrokeThickness="0" Padding="16,12">
        <Label TextColor="#1F4E9C" FontAttributes="Bold" Text="① Root Header View" />
      </Border>
    </ks:SettingsView.RootHeaderView>

    <ks:SettingsView.RootFooterView>
      <Border BackgroundColor="#DDEBFF" StrokeThickness="0" Padding="16,12">
        <Label TextColor="#1F4E9C" FontAttributes="Bold" Text="① Root Footer View" />
      </Border>
    </ks:SettingsView.RootFooterView>

    <!--
      ② Section の Header / Footer へ置いた View。Header View は所有 Section の
      BindingContext を継承するため、ViewModel の値をそのままバインドできる。
    -->
    <ks:Section>
      <ks:Section.HeaderView>
        <Border BackgroundColor="#E4F3E6" StrokeThickness="0" Padding="16,12">
          <VerticalStackLayout Spacing="2">
            <Label TextColor="#2E6B33" FontAttributes="Bold" Text="② Section Header View" />
            <Label TextColor="#2E6B33" FontSize="12" Text="{Binding BoundText}" />
          </VerticalStackLayout>
        </Border>
      </ks:Section.HeaderView>
      <ks:Section.FooterView>
        <Border BackgroundColor="#E4F3E6" StrokeThickness="0" Padding="16,12">
          <Label TextColor="#2E6B33" FontSize="12" Text="② Section Footer View" />
        </Border>
      </ks:Section.FooterView>

      <ks:LabelCell Title="Header View のバインド"
                    Description="下のボタンで ViewModel の値を書き換えると、View を置き直さずに表示が変わる" />
      <ks:ButtonCell Title="バインド元の値を変える" Tapped="OnChangeBoundTextTapped" />
    </ks:Section>

    <!-- ③ text と View の両方があるときは View が優先され、View を外すと text が現れる。 -->
    <ks:Section x:Name="CoexistSection" HeaderText="③ Header Text（View を外すと現れる）">
      <ks:Section.HeaderView>
        <Border x:Name="CoexistHeaderView" BackgroundColor="#EDE3F7" StrokeThickness="0" Padding="16,12">
          <Label TextColor="#5B3A8C" FontAttributes="Bold" Text="③ Header View（Header Text より優先）" />
        </Border>
      </ks:Section.HeaderView>

      <ks:LabelCell Title="View 優先とフォールバック"
                    Description="View を外すと Header Text が表示され、戻すと再び View が表示される" />
      <ks:ButtonCell x:Name="CoexistToggleCell"
                     Title="Header View を外す"
                     Tapped="OnToggleCoexistViewTapped" />
    </ks:Section>

    <!-- ④ 別インスタンスへの差し替え。Header View はページ側で作り直して設定する。 -->
    <ks:Section x:Name="SwapSection">
      <ks:LabelCell Title="別インスタンスへの差し替え"
                    Description="押すたびに新しい View を作って設定する。色と回数が変われば差し替わっている" />
      <ks:ButtonCell Title="Header View を差し替える" Tapped="OnSwapHeaderViewTapped" />
    </ks:Section>

    <!-- ⑤ 同じ View のまま内容だけが変わるときの、自動高さの追従。 -->
    <ks:Section>
      <ks:Section.HeaderView>
        <Border BackgroundColor="#FFF1CC" StrokeThickness="0" Padding="16,12">
          <VerticalStackLayout Spacing="2">
            <Label TextColor="#8A6100" FontAttributes="Bold" Text="⑤ 高さが追従する Header View" />
            <Label TextColor="#8A6100" FontSize="12" Text="{Binding GrowingText}" />
          </VerticalStackLayout>
        </Border>
      </ks:Section.HeaderView>

      <ks:LabelCell Title="内容変化への高さ追従"
                    Description="Header の行数を 1 行 ⇔ 3 行で切り替える。領域の高さが内容に追従する" />
      <ks:ButtonCell Title="Header の行数を切り替える" Tapped="OnToggleGrowingTextTapped" />
    </ks:Section>

    <!-- ⑥ HeaderHeight を指定すると固定高さになり、はみ出した内容は表示されない。 -->
    <ks:Section HeaderHeight="44">
      <ks:Section.HeaderView>
        <Border BackgroundColor="#FBDDDD" StrokeThickness="0" Padding="16,12">
          <VerticalStackLayout Spacing="2">
            <Label TextColor="#9C2A2A" FontAttributes="Bold" Text="⑥ HeaderHeight = 44 の Header View" />
            <Label TextColor="#9C2A2A" FontSize="12" Text="この 2 行目と 3 行目は" />
            <Label TextColor="#9C2A2A" FontSize="12" Text="固定高さからはみ出すため表示されない" />
          </VerticalStackLayout>
        </Border>
      </ks:Section.HeaderView>

      <ks:LabelCell Title="固定高さでの切り詰め"
                    Description="HeaderHeight を指定した領域は内容に関わらず 44 の高さになる" />
    </ks:Section>

    <!-- ⑦ 同じページインスタンスのまま Handler の切断と再接続を起こし、復元を確認する。 -->
    <ks:Section>
      <ks:Section.HeaderView>
        <Border BackgroundColor="#DCE7EA" StrokeThickness="0" Padding="16,12">
          <VerticalStackLayout Spacing="2">
            <Label TextColor="#2B5A63" FontAttributes="Bold" Text="⑦ 切断・再接続をまたぐ Header View" />
            <Label TextColor="#2B5A63" FontSize="12" Text="{Binding ReconnectText}" />
          </VerticalStackLayout>
        </Border>
      </ks:Section.HeaderView>

      <ks:LabelCell Title="このページ" ValueText="{Binding InstanceText}" />
      <ks:LabelCell Title="切断・再接続をまたぐ復元"
                    Description="一覧まで戻ってから同じインスタンスを開き直す。離脱中に Root Header View も差し替える" />
      <ks:ButtonCell Title="離れて戻る（Handler 切断 → 再接続）" Tapped="OnReconnectTapped" />
    </ks:Section>

  </ks:SettingsView>
</ContentPage>
