<?xml version="1.0" encoding="utf-8"?>
<!--
  KsSettingsView Sample (Android) — AndroidManifest.xml

  ComponentActivity ベースの単一 Activity（MainActivity）をエントリポイントとする。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      android:theme:
        フレームワーク標準の素のテーマを親に取る自前 style を指定する。Material3 の XML テーマも
        AppCompat の XML テーマも持たない Compose 専業アプリ（Compose テンプレートの既定構成）を模し、
        KsSettingsView がホストのテーマ種別を問わずに動作することを示すため。
        style は values/ と values-night/ に同名で置き、夜間モードで暗い側が選ばれる。

        ライブラリの View と選択面は、ライブラリが同梱する Material3 派生テーマを
        かぶせた Context から生成されるので、ホスト側でテーマを整える必要はない
        (android/ADR-0020)。ホストのテーマはこの Sample 自身の Compose UI と
        ウィンドウの見栄えだけを決める。
    -->
    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.KsSettingsViewSample"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
