<?xml version="1.0" encoding="utf-8"?>
<!--
  KsSettingsView Sample (Android) — AndroidManifest.xml

  ComponentActivity ベースの単一 Activity（MainActivity）をエントリポイントとする。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      android:theme:
        フレームワーク標準の素のテーマを指定する。Material3 の XML テーマも AppCompat の
        XML テーマも持たない Compose 専業アプリ（Compose テンプレートの既定構成）を模し、
        ks-settingsview-ui がホストのテーマ種別を問わずに動作することを示すため。

        ライブラリの View と選択面は、ライブラリが同梱する Material3 派生テーマを
        かぶせた Context から生成されるので、ホスト側でテーマを整える必要はない
        (android/ADR-0020)。ホストのテーマはこの Sample 自身の Compose UI と
        ウィンドウの見栄えだけを決める。
    -->
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
