# ===============================
# KsSettingsView monorepo .gitignore
# ===============================

# ----- 一般 -----
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp
*.swo

# ----- IDE / エディタ -----
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.iml
*.ipr
*.iws

# ----- .NET / MAUI -----
bin/
obj/
[Bb]in/
[Oo]bj/
*.binlog
*.nupkg
*.snupkg
.vs/
TestResults/

# ----- Android / Gradle -----
build/
.gradle/
# Kotlin 2.x のビルドセッション作業ディレクトリ
.kotlin/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.aar
*.dex
*.class

# ----- iOS / Swift / Xcode -----
.build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
Package.resolved
*.ipa
*.dSYM.zip
*.dSYM
# Xcode が xcodebuild 実行時に生成するビルドログ（拡張子なし、サフィックスはランダム）
.derived-data-log-*

# ----- Node / 補助ツール -----
node_modules/

# scripts/ の Python 補助ツールが生成するバイトコードキャッシュ
__pycache__/
*.pyc

## ---- AI 関連 -----
# settings.json はプロジェクト共有設定 (hooks 登録等) のため追跡する。個人設定は settings.local.json へ
.claude/settings.local.json
.claude/plans/

# ----- 機密情報 / 署名鍵 -----
# 誤コミット防止。追跡中の該当ファイルは無い (2026-08-23 確認)
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.mobileprovision
google-services.json
keystore.properties
secrets.*
.env.*
# JVM のクラッシュダンプ (上の *.log にも該当するが明示する)
hs_err_pid*.log

# ----- OS / その他 -----
*.orig
.env

# ----- OpenSpec 補助 -----
# VS Code 上でフォルダの自動展開を防ぐためのダミーファイル（ローカル保持・コミット対象外）
openspec/changes/dummy.txt

# ----- Kasane 証跡 -----
# change 配下の視覚照合・実行ログ証跡は、上の *.log 除外の例外として追跡する
!kasane/changes/**/verification/*.log
